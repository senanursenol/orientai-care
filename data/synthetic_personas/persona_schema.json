{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "OrientAI Synthetic Patient Persona Schema",
  "description": "Schema for synthetic dementia or Alzheimer patient personas used in OrientAI.",
  "type": "object",
  "required": [
    "patient_id",
    "metadata",
    "orientation_support",
    "daily_routines",
    "medications",
    "core_memories",
    "family_members",
    "communication_preferences",
    "sample_questions",
    "safety_notes"
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Unique synthetic patient identifier."
    },
    "metadata": {
      "type": "object",
      "required": [
        "full_name",
        "age",
        "gender",
        "diagnosis",
        "disease_stage",
        "former_profession",
        "living_status",
        "primary_caregiver"
      ],
      "properties": {
        "full_name": {
          "type": "string"
        },
        "age": {
          "type": "integer",
          "minimum": 60,
          "maximum": 100
        },
        "gender": {
          "type": "string",
          "enum": ["female", "male"]
        },
        "diagnosis": {
          "type": "string"
        },
        "disease_stage": {
          "type": "string",
          "enum": ["mild", "moderate"]
        },
        "former_profession": {
          "type": "string"
        },
        "living_status": {
          "type": "string"
        },
        "primary_caregiver": {
          "type": "string"
        }
      }
    },
    "orientation_support": {
      "type": "object",
      "required": [
        "current_home",
        "safe_place_reminder",
        "reassurance_message",
        "emergency_contact_name",
        "emergency_contact_relation"
      ],
      "properties": {
        "current_home": {
          "type": "string"
        },
        "safe_place_reminder": {
          "type": "string"
        },
        "reassurance_message": {
          "type": "string"
        },
        "emergency_contact_name": {
          "type": "string"
        },
        "emergency_contact_relation": {
          "type": "string"
        }
      }
    },
    "daily_routines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "activity",
          "description",
          "reminder_type"
        ],
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "activity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reminder_type": {
            "type": "string",
            "enum": [
              "medication",
              "meal",
              "activity",
              "appointment",
              "personal_care",
              "sleep"
            ]
          }
        }
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "time",
          "dose",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "dose": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "core_memories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "memory_id",
          "category",
          "content",
          "keywords",
          "emotional_tone"
        ],
        "properties": {
          "memory_id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "family",
              "work",
              "place",
              "hobby",
              "routine",
              "personal_history",
              "visual_memory"
            ]
          },
          "content": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "emotional_tone": {
            "type": "string",
            "enum": [
              "positive",
              "neutral",
              "calming"
            ]
          }
        }
      }
    },
    "family_members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "relation",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "communication_preferences": {
      "type": "object",
      "required": [
        "preferred_language",
        "tone",
        "answer_length",
        "avoid"
      ],
      "properties": {
        "preferred_language": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "answer_length": {
          "type": "string",
          "enum": ["short", "medium"]
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sample_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "expected_answer_type",
          "expected_context_keywords"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "expected_answer_type": {
            "type": "string",
            "enum": [
              "orientation",
              "family_recall",
              "routine_reminder",
              "medication_reminder",
              "memory_recall",
              "safety_fallback"
            ]
          },
          "expected_context_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "safety_notes": {
      "type": "object",
      "required": [
        "medical_advice_policy",
        "hallucination_policy",
        "emergency_policy"
      ],
      "properties": {
        "medical_advice_policy": {
          "type": "string"
        },
        "hallucination_policy": {
          "type": "string"
        },
        "emergency_policy": {
          "type": "string"
        }
      }
    }
  }
}