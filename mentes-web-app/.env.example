# Backend API base URL — React yalnızca Node.js/Express backend'ine konuşur.
# AI (chat/voice/vision/tts) istekleri de bu backend üzerinden Python AI
# servisine köprülenir; frontend'in Python'a doğrudan bir bağlantısı yoktur.
VITE_API_BASE_URL=http://localhost:4100/api

# Bakım veren panelinin veri kaynağı (ORI-32/34/35/36).
#   persona -> data/synthetic_personas/ahmet_yilmaz.json türevi (varsayılan)
#   backend -> Node caregiver endpointleri
# Endpointler açıldığında backend yapmak yeterli; kod değişmez.
VITE_DASHBOARD_SOURCE=persona
